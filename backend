import re
import shutil
import threading
from pathlib import Path
from typing import Dict, List

import torch
from fastapi import FastAPI, File, HTTPException, UploadFile
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel
from langchain_community.document_loaders import PyPDFLoader
from langchain_text_splitters import RecursiveCharacterTextSplitter
from langchain_huggingface import HuggingFaceEmbeddings
from langchain_community.vectorstores import FAISS
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM


# --------------------------------------------------
# CONFIGURATION
# --------------------------------------------------

app = FastAPI(
    title="Legal RAG Chatbot",
    description="Question Answering & Summarization on Legal Documents",
    version="1.1.0",
)

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

BASE_DIR = Path(__file__).resolve().parent
DATA_DIR = BASE_DIR / "data"
UPLOAD_DIR = DATA_DIR / "uploads"
CONSTITUTION_PDF = DATA_DIR / "constitution.pdf"

MAX_SESSION_BYTES = 10 * 1024 * 1024   # 10 MB
MAX_TOTAL_BYTES = 50 * 1024 * 1024     # 50 MB

DATA_DIR.mkdir(parents=True, exist_ok=True)
UPLOAD_DIR.mkdir(parents=True, exist_ok=True)

history_lock = threading.Lock()
index_lock = threading.Lock()

# Session histories and uploaded document metadata are held in memory.
# Uploaded PDF files themselves are stored on disk.
chat_histories: Dict[str, list] = {}
uploaded_documents: Dict[str, dict] = {}


# --------------------------------------------------
# REQUEST MODELS
# --------------------------------------------------

class Question(BaseModel):
    query: str
    session_id: str = "default"


# --------------------------------------------------
# HELPERS
# --------------------------------------------------

def clean_text(text: str) -> str:
    return re.sub(r"\s+", " ", text).strip()


def safe_session_id(session_id: str) -> str:
    """Restrict session IDs to safe directory-name characters."""
    cleaned = re.sub(r"[^a-zA-Z0-9_-]", "_", session_id or "default")
    return cleaned[:100] or "default"


def session_upload_dir(session_id: str) -> Path:
    folder = UPLOAD_DIR / safe_session_id(session_id)
    folder.mkdir(parents=True, exist_ok=True)
    return folder


def get_uploaded_files() -> List[Path]:
    return sorted(UPLOAD_DIR.glob("*/*.pdf"))


def get_total_upload_bytes() -> int:
    return sum(path.stat().st_size for path in get_uploaded_files())


def get_session_upload_bytes(session_id: str) -> int:
    folder = session_upload_dir(session_id)
    return sum(
        path.stat().st_size
        for path in folder.glob("*.pdf")
        if path.is_file()
    )


def document_record(path: Path) -> dict:
    try:
        relative_path = path.relative_to(UPLOAD_DIR)
        session_id = relative_path.parts[0]
    except (ValueError, IndexError):
        session_id = "default"

    return {
        "name": path.name,
        "filename": path.name,
        "session_id": session_id,
        "size": path.stat().st_size,
        "size_bytes": path.stat().st_size,
    }


def load_pdf_documents(path: Path):
    """Load a PDF and attach its source filename to each page."""
    pages = PyPDFLoader(str(path)).load()
    for page in pages:
        page.metadata["source"] = path.name
    return pages


# --------------------------------------------------
# LOAD EMBEDDINGS, DOCUMENTS AND LANGUAGE MODEL
# --------------------------------------------------

if not CONSTITUTION_PDF.exists():
    raise FileNotFoundError(
        f"Constitution PDF not found: {CONSTITUTION_PDF}. "
        "Place constitution.pdf inside backend/data/."
    )

text_splitter = RecursiveCharacterTextSplitter(
    chunk_size=800,
    chunk_overlap=150,
)

embeddings = HuggingFaceEmbeddings(
    model_name="sentence-transformers/all-MiniLM-L6-v2"
)

model_name = "facebook/bart-large-cnn"
tokenizer = AutoTokenizer.from_pretrained(model_name)
model = AutoModelForSeq2SeqLM.from_pretrained(model_name)
model.eval()


def rebuild_vectorstore():
    """Index the Constitution and all saved uploaded PDFs."""
    global vectorstore

    all_pages = load_pdf_documents(CONSTITUTION_PDF)

    for pdf_path in get_uploaded_files():
        try:
            all_pages.extend(load_pdf_documents(pdf_path))
        except Exception as exc:
            print(f"Skipping unreadable PDF {pdf_path.name}: {exc}")

    chunks = text_splitter.split_documents(all_pages)

    if not chunks:
        raise RuntimeError("No readable text was found in the PDF files.")

    vectorstore = FAISS.from_documents(chunks, embeddings)
    print(f"Indexed {len(chunks)} text chunks.")


# Create the initial searchable index.
rebuild_vectorstore()


# Rebuild document metadata from files already on disk.
for existing_pdf in get_uploaded_files():
    try:
        record = document_record(existing_pdf)
        uploaded_documents[
            f"{record['session_id']}/{record['name']}"
        ] = record
    except OSError:
        pass


